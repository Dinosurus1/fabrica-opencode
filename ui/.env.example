# Copia a .env.local o exporta estas variables en el servicio.
# No guardes secretos en el repositorio.

# Contraseña propia de la consola. Si falta, se usa la de service.json.
FACTORY_UI_PASSWORD=

# Obliga login incluso si no hay contraseña configurada (para Tailscale).
FACTORY_UI_REQUIRE_AUTH=1

# Interfaz y puerto. Deja 127.0.0.1 y publica con Tailscale Serve.
FACTORY_UI_HOST=127.0.0.1
FACTORY_UI_PORT=4173

# Upstream de OpenCode.
OPENCODE_URL=http://127.0.0.1:49374

# Hosts adicionales permitidos (separados por comas) además de localhost y *.ts.net.
FACTORY_UI_ALLOWED_HOSTS=

# Duración de la cookie de sesión en segundos (7 días por defecto).
FACTORY_UI_SESSION_TTL=604800
