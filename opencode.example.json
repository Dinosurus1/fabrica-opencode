{
  "$schema": "https://opencode.ai/config.json",
  "theme": "system",
  "autoupdate": false,
  "mcp": {
    "servers": {
      "rocminfo": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--directory",
          "{env:ROCM_MCP_DIR}",
          "rocminfo-mcp"
        ]
      },
      "amd-smi": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "--directory",
          "{env:ROCM_MCP_DIR}",
          "amd-smi-mcp"
        ]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "headers": {
          "Authorization": "Bearer {env:CONTEXT7_TOKEN}"
        }
      }
    }
  },
  "default_agent": "factory"
}
